# Only this port's virtual pen: hover/side buttons are forced to pressure zero.
# Avoid applying libinput's additional 5% tip threshold to already gated force.
[Tomate MTM-1118 virtual pen pressure]
MatchName=Tomate MTM-1118 Bosto Stylus Pen
MatchVendor=0x0ED1
MatchProduct=0x7821
MatchUdevType=tablet
AttrPressureRange=1:0
